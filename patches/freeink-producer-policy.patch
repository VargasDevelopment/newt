+// Parser-as-handler argument keeps the ordinary handler in Expat's existing
+// user-data slot; producer callbacks need no allocated wrapper/context.
+void XMLCALL producerStart(void* parser, const XML_Char* name, const XML_Char** atts) {
+  startElement(XML_GetUserData(static_cast<XML_Parser>(parser)), name, atts);
+}
+void XMLCALL producerEnd(void* parser, const XML_Char* name) {
+  endElement(XML_GetUserData(static_cast<XML_Parser>(parser)), name);
+}
+void XMLCALL producerText(void* parser, const XML_Char* text, int len) {
+  characterData(XML_GetUserData(static_cast<XML_Parser>(parser)), text, len);
+}
+void XMLCALL producerDoctype(void* parser, const XML_Char*, const XML_Char*, const XML_Char*,
