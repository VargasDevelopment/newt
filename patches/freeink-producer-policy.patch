+  // Called before the internal subset is processed, including entity declarations.
+  if (internalSubset) XML_StopParser(static_cast<XML_Parser>(parser), XML_FALSE);
+}
+int XMLCALL producerExternal(XML_Parser, const XML_Char*, const XML_Char*, const XML_Char*,
+                             const XML_Char*) { return XML_STATUS_ERROR; }
