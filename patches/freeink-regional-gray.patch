+struct BinaryGrayIslandRegion { uint16_t x, y, width, height; };
+// Immutable, static-lifetime native rectangles whose packed byte total is at
+// most 480. X coordinates and widths are byte aligned and regions are disjoint.
+// A driver may retain this object's address until its binary proof is invalid.
+struct BinaryGrayRegion { uint16_t x, y, width, height; };
+struct BinaryGrayRegionPlan {
+  const BinaryGrayRegion* regions;
+  uint8_t count;
+  // Opt in to one vertical PTL spanning selected parallel regions. Rows outside
+  // the selected rectangles are staged as white-to-white controller selectors.
+  bool neutralGaps = false;
+};
+
+// Public callers bind the region array itself as a non-type template argument.
+// That gives both retained objects static lifetime: the array is named in the
+// program image and this descriptor is one inline constant per array/count.
+// Reading every rectangle in a constant expression also rejects mutable or
+// merely runtime-initialized arrays before the facade can retain their address.
+template<const BinaryGrayRegion* Regions, uint8_t Count, bool NeutralGaps = false>
+struct BinaryGrayPlanBinding {
+ private:
+  static constexpr bool validGeometry() {
+    if (Regions == nullptr || !Count || Count > 32) return false;
+    uint32_t bytes = 0;
+    for (uint8_t i = 0; i < Count; ++i) {
+      const auto& region = Regions[i];
+      if (!region.width || !region.height || (region.x & 7u) || (region.width & 7u) ||
+          region.x >= 792 || region.y >= 528 || region.width > 792 - region.x ||
+          region.height > 528 - region.y) return false;
+      bytes += static_cast<uint32_t>(region.width / 8) * region.height;
+      if (bytes > 480) return false;
+      for (uint8_t previous = 0; previous < i; ++previous) {
+        const auto& other = Regions[previous];
+        const bool disjoint = region.x + region.width <= other.x ||
+            other.x + other.width <= region.x || region.y + region.height <= other.y ||
+            other.y + other.height <= region.y;
+        if (!disjoint) return false;
+      }
+    }
+    if (NeutralGaps) {
+      const auto x = Regions[0].x;
+      const auto width = Regions[0].width;
+      uint16_t yStart = Regions[0].y;
+      uint16_t yEnd = static_cast<uint16_t>(Regions[0].y + Regions[0].height);
+      for (uint8_t i = 1; i < Count; ++i) {
+        if (Regions[i].x != x || Regions[i].width != width) return false;
+        if (Regions[i].y < yStart) yStart = Regions[i].y;
+        const uint16_t end = static_cast<uint16_t>(Regions[i].y + Regions[i].height);
+        if (end > yEnd) yEnd = end;
+      }
+      if (static_cast<uint32_t>(width / 8) * (yEnd - yStart) > 480) return false;
+    }
+    return true;
+  }
+
+ public:
+  static_assert(validGeometry(),
+                "binary gray regions must be immutable, disjoint, byte-aligned X3 rectangles totaling at most 480 bytes; neutral gaps additionally require one X/width and a 480-byte encompassing strip");
+  inline static constexpr BinaryGrayRegionPlan plan{Regions, Count, NeutralGaps};
+};
